{
  "name": "image_ocr_agent",
  "description": "Extract text from images",
  "capabilities": [
    "image_ocr",
    "ocr",
    "image_text_extraction"
  ],
  "input_schema": {
    "image_path": "string",
    "file_url": "string"
  },
  "output_schema": {
    "success": "boolean",
    "ocr_id": "string",
    "extracted_text": "string"
  }
}